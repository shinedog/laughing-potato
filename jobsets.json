{
  "enabled": 1,
  "hidden": 0,
  "type": 0,
  "description": "Generate branch and pull request jobsets for shinedog/laughing-potato",
  "nixexprinput": "src",
  "nixexprpath": ".hydra/jobsets.nix",
  "checkinterval": 60,
  "schedulingshares": 100,
  "enableemail": 0,
  "emailoverride": "",
  "keepnr": 3,
  "inputs": {
    "src": {
      "type": "git",
      "value": "git+ssh://git@github.com/shinedog/laughing-potato 5-building-a-declarative-hydra-jobset-and-jobs-from-github",
      "emailresponsible": false
    },
    "nixpkgs": {
      "type": "git",
      "value": "https://github.com/NixOS/nixpkgs.git nixos-25.05",
      "emailresponsible": false
    },
    "branches": {
      "type": "github_refs",
      "value": "shinedog laughing-potato heads - .",
      "emailresponsible": false
    },
    "pulls": {
      "type": "githubpulls",
      "value": "shinedog laughing-potato",
      "emailresponsible": false
    }
  }
}
